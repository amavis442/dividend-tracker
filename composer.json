{
    "type": "project",
    "license": "MIT",
    "version": "2.0.0",
    "homepage": "https://gitlab.com/amavis442/dividend",
    "authors": [
        {
            "name": "Patrick Teunissen",
            "email": "patrick@example.com",
            "homepage": "https://gitlab.com/amavis442",
            "role": "Developer"
        }
    ],
    "keywords": [
        "trading",
        "tracker",
        "dividends",
        "stocks"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/core": "^4.3",
        "babdev/pagerfanta-bundle": "^4.4",
        "beberlei/doctrineextensions": "^1.5",
        "brick/math": "^0.13.1",
        "brick/money": "^0.10.1",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.5 || ^4.0",
        "mtdowling/jmespath.php": "^2.8",
        "n5s/brotli": "^3.0",
        "nelmio/cors-bundle": "^2.3",
        "nesbot/carbon": "^3.8",
        "nikic/php-parser": "^5.2",
        "openspout/openspout": "^4.24",
        "pagerfanta/doctrine-orm-adapter": "^4.7",
        "pagerfanta/twig": "^4.7",
        "sabre/xml": "^4.0",
        "symfony/asset": "^8.1",
        "symfony/asset-mapper": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/intl": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/mercure-bundle": "^0.3.9 || ^0.4",
        "symfony/mime": "^8.1",
        "symfony/monolog-bundle": "^3.8 || ^4.0",
        "symfony/notifier": "^8.1",
        "symfony/options-resolver": "^8.1",
        "symfony/process": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/string": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/ux-autocomplete": "^2.19",
        "symfony/ux-chartjs": "^2.19",
        "symfony/ux-dropzone": "^2.20",
        "symfony/ux-turbo": "^2.20",
        "symfony/ux-twig-component": "^2.20",
        "symfony/validator": "^8.1",
        "symfony/web-link": "^8.1",
        "symfony/yaml": "^8.1",
        "symfonycasts/tailwind-bundle": "^1.0",
        "twig/cssinliner-extra": "^3.13",
        "twig/extra-bundle": "^3.0",
        "twig/inky-extra": "^3.13",
        "twig/intl-extra": "^3.13",
        "twig/markdown-extra": "^3.13",
        "twig/twig": "^3.0",
        "zbateson/mail-mime-parser": "^3.0"
    },
    "require-dev": {
        "behat/behat": "^3.14 || ^4.0@alpha",
        "dama/doctrine-test-bundle": "^8.2",
        "deployer/deployer": "^7.5",
        "doctrine/coding-standard": "^13.0",
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "fakerphp/faker": "^1.23",
        "friends-of-behat/symfony-extension": "^2.6 || ^3.0@alpha",
        "friendsofphp/php-cs-fixer": "*",
        "phpdocumentor/reflection-docblock": "^5.3",
        "phpdocumentor/shim": "^3.8",
        "phpspec/phpspec": "^8.0",
        "phpstan/phpdoc-parser": "^2.2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.1",
        "squizlabs/php_codesniffer": "^3.6",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.61",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/web-profiler-bundle": "^8.1",
        "zenstruck/browser": "^1.8",
        "zenstruck/foundry": "^2.2"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "phpdocumentor/shim": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Tests\\Unit\\": "tests/Unit/",
            "App\\Tests\\Features\\": "tests/Features/",
            "App\\Tests\\Functional\\": "tests/Functional/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:precommit": [
            "@phpstan",
            "@phpunit"
        ],
        "csfix": "phpcbf --ignore=migrations/**,src/Kernel.php,bin/**",
        "cscheck": "phpcs --ignore=migrations/**,src/Kernel.php,bin/**",
        "phpstan": "phpstan analyse src/ -c phpstan.neon --level=5 --no-progress -vvv --memory-limit=1024M",
        "phpunit": "SYMFONY_DEPRECATIONS_HELPER=disabled xdebug_enabled=true XDEBUG_MODE=coverage vendor/bin/phpunit  --do-not-fail-on-warning --do-not-fail-on-risky --coverage-html var/coverage"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
